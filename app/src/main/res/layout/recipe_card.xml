<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#30264F">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCardRecipeName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dovi"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#F0E9FF"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="#CBB6FF"
                    android:paddingStart="6dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvCardCountry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zimbabwe"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#211B2A"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="#CBB6FF" />

                <TextView
                    android:id="@+id/tvCardCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Traditional"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#211B2A"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="#A8DADC"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#473C59"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvCardDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A Zimbabwean peanut butter chicken stew."
                android:textSize="13sp"
                android:textColor="#C5BDD2"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap to view recipe"
                android:textSize="11sp"
                android:textColor="#968DA6"
                android:layout_marginTop="10dp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <View
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:background="@android:color/transparent" />

</LinearLayout>
