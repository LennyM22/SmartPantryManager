<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#17151B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Ingredient"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#E8DFFF"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add an ingredient to your pantry"
            android:textSize="14sp"
            android:textColor="#BDB6C8"
            android:gravity="center"
            android:layout_marginBottom="22dp" />

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#24212A">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ingredient Details"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#E8DFFF"
                    android:layout_marginBottom="14dp" />

                <EditText
                    android:id="@+id/etIngredientName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Ingredient name"
                    android:textColor="#E8DFFF"
                    android:textColorHint="#8F8999"
                    android:textSize="15sp"
                    android:inputType="text"
                    android:singleLine="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="#30283D"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Quantity"
                    android:textColor="#E8DFFF"
                    android:textColorHint="#8F8999"
                    android:textSize="15sp"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="#30283D"
                    android:layout_marginBottom="12dp" />

                <Spinner
                    android:id="@+id/spinnerUnit"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="#30283D"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginBottom="12dp" />

                <Spinner
                    android:id="@+id/spinnerCategory"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="#30283D"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etExpiryDate"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Expiry date"
                    android:textColor="#E8DFFF"
                    android:textColorHint="#8F8999"
                    android:textSize="15sp"
                    android:focusable="false"
                    android:clickable="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="#30283D" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnSaveIngredient"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="SAVE INGREDIENT"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#211B2A"
            android:backgroundTint="#CBB6FF"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>
